{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "talos/clusterconfig/**"
  ],
  "labels": [
    "renovate"
  ],
  "helmv3": {
    "managerFilePatterns": ["/k8s/charts/.+/Chart\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/k8s/charts/.+/values\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/talos/talconfig\\.yaml$/"],
      "matchStrings": ["talosVersion:\\s*(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/talos/talconfig\\.yaml$/"],
      "matchStrings": ["kubernetesVersion:\\s*(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/charts/argocd/values\\.yaml$/"],
      "matchStrings": ["name:\\s*HELM_SECRETS_VERSION\\s*\\n\\s*value:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jkroepke/helm-secrets",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/charts/argocd/values\\.yaml$/"],
      "matchStrings": ["name:\\s*KUBECTL_VERSION\\s*\\n\\s*value:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/charts/argocd/values\\.yaml$/"],
      "matchStrings": ["name:\\s*VALS_VERSION\\s*\\n\\s*value:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helmfile/vals",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/charts/argocd/values\\.yaml$/"],
      "matchStrings": ["name:\\s*SOPS_VERSION\\s*\\n\\s*value:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "getsops/sops",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/charts/argocd/values\\.yaml$/"],
      "matchStrings": ["name:\\s*AGE_VERSION\\s*\\n\\s*value:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "FiloSottile/age",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch updates except for Talos and K8s",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["!siderolabs/talos", "!kubernetes/kubernetes"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "groupName": "Helm chart dependencies",
      "matchManagers": ["helmv3"]
    },
    {
      "groupName": "Container images",
      "matchManagers": ["helm-values"]
    },
    {
      "groupName": "Talos Linux",
      "matchPackageNames": ["siderolabs/talos"]
    },
    {
      "groupName": "Kubernetes",
      "matchPackageNames": ["kubernetes/kubernetes"]
    },
    {
      "groupName": "Talos + Kubernetes",
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "automerge": false
    }
  ]
}
